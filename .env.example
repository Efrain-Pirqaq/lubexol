# ==========================================
# LUBEXOL — Variables de Entorno (Plantilla)
# ==========================================
# IMPORTANTE: No incluir credenciales reales en este archivo.
# Duplicar este archivo como '.env' para desarrollo local.

# --- Identidad y Canales de Venta (Públicas) ---
PUBLIC_SITE_URL="https://aceitedemotorlima.com"
# Requerido: Número oficial de WhatsApp del asesor asignado (sin '+', espacios ni guiones; dejar vacío hasta configurar)
PUBLIC_WHATSAPP_NUMBER=""
PUBLIC_WHATSAPP_DEFAULT_PREFIX="Hola Lubexol, quisiera cotizar lo siguiente con su asesor:"

# --- Notificaciones Transaccionales (Resend) ---
# API Key obtenida en https://resend.com/api-keys
RESEND_API_KEY="re_placeholder_xxxxxxxxxxxx"
# Remitente verificado en Resend (o onboarding@resend.dev para pruebas iniciales)
RESEND_FROM_EMAIL="notificaciones@lubexol.pe"
# Correo del Administrador que recibirá las alertas inmediatas de leads
ADMIN_NOTIFICATION_EMAIL="admin@lubexol.pe"

# --- Registro de Leads (Google Sheets) ---
# Opción recomendada para Edge / Serverless sin dependencias pesadas:
# URL del Webhook de Google Apps Script vinculado a la hoja de cálculo
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycb_placeholder_exec/exec"
# Token secreto para validar que las peticiones al Webhook provengan exclusivamente de nuestra web
GOOGLE_SHEETS_WEBHOOK_SECRET="secreto_aleatorio_32_caracteres_minimo"

# --- Entorno de Ejecución ---
NODE_ENV="development"
