---
import '../styles/global.css';
import { getCatalogData } from '@/services/catalog';
import ProductCard from '@/components/ProductCard.astro';

const { catalog, whatsappNumber } = await getCatalogData();
const hasProducts = catalog.length > 0;
const siteUrl = 'https://aceitedemotorlima.com';
const defaultWaUrl = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hola Aceite de Motor Lima, quisiera información y cotización sobre lubricantes por caja.')}`
  : '#';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'AutoPartsStore',
  name: 'Aceite de Motor Lima',
  alternateName: 'Distribuidor Mayorista Lubexol Lima',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  image: `${siteUrl}/images/products/lubexol-optimus-premium-20w50.jpeg`,
  description:
    'Venta y distribución de lubricantes de motor por caja cerrada de 15 y 20 unidades para taxistas, particulares y flotas comerciales en Lima Metropolitana y Callao.',
  telephone: whatsappNumber ? `+${whatsappNumber}` : undefined,
  priceRange: '$$',
  currenciesAccepted: 'PEN',
  paymentAccepted: 'Efectivo, Transferencia Bancaria, Yape, Plin',
  areaServed: [
    { '@type': 'City', name: 'Lima' },
    { '@type': 'City', name: 'Callao' },
    { '@type': 'AdministrativeArea', name: 'Lima Metropolitana' },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Lima Metropolitana y Callao (Distribución y Despacho)',
    addressLocality: 'Lima',
    addressRegion: 'Lima',
    postalCode: '15001',
    addressCountry: 'PE',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:00',
      closes: '19:00',
    },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Catálogo de Lubricantes por Caja',
    itemListElement: catalog.map((p, index) => {
      const priceMap: Record<string, string> = {
        'lubexol-optimus-premium-20w50': '245.00',
        'lubexol-ultra-oil-15w40': '255.00',
        'lubexol-hd50-gnv-glp': '225.00',
        'lubexol-turbo-vis-25w60': '260.00',
        'lubexol-hd40-ultra-oil': '220.00',
        'lubexol-moto-4t-25w60': '230.00',
      };
      const price = priceMap[p.id] || '245.00';
      const imgUrl = p.imageUrl?.startsWith('http') ? p.imageUrl : `${siteUrl}${p.imageUrl}`;

      return {
        '@type': 'Offer',
        position: index + 1,
        itemOffered: {
          '@type': 'Product',
          name: p.name,
          description: p.description,
          image: imgUrl,
          brand: { '@type': 'Brand', name: p.brand },
          sku: p.variants?.[0]?.sku || p.id,
          offers: {
            '@type': 'Offer',
            url: `${siteUrl}#catalogo`,
            priceCurrency: 'PEN',
            price: price,
            priceValidUntil: '2027-12-31',
            itemCondition: 'https://schema.org/NewCondition',
            availability: p.status === 'archived' ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
            seller: {
              '@type': 'AutoPartsStore',
              name: 'Aceite de Motor Lima',
            },
            shippingDetails: {
              '@type': 'OfferShippingDetails',
              shippingRate: {
                '@type': 'MonetaryAmount',
                value: '0.00',
                currency: 'PEN',
              },
              shippingDestination: {
                '@type': 'DefinedRegion',
                addressCountry: 'PE',
                addressRegion: 'Lima',
              },
              deliveryTime: {
                '@type': 'ShippingDeliveryTime',
                handlingTime: {
                  '@type': 'QuantitativeValue',
                  minValue: 0,
                  maxValue: 1,
                  unitCode: 'DAY',
                },
                transitTime: {
                  '@type': 'QuantitativeValue',
                  minValue: 1,
                  maxValue: 2,
                  unitCode: 'DAY',
                },
              },
            },
            hasMerchantReturnPolicy: {
              '@type': 'MerchantReturnPolicy',
              applicableCountry: 'PE',
              returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
              merchantReturnDays: 7,
              returnMethod: 'https://schema.org/ReturnInStore',
              returnFees: 'https://schema.org/FreeReturn',
            },
          },
        },
      };
    }),
  },
};

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Cómo garantizan que el aceite es 100% original y sellado de fábrica?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Todos los lubricantes Lubexol provienen directamente de planta con precinto de inviolabilidad de fábrica, números de lote trazables y fichas técnicas oficiales. Garantizamos cero riesgo de aceites reciclados o adulterados, protegiendo al 100% la vida útil de tu motor.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Por qué los motores a gas (GNV / GLP) necesitan un aceite especializado?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'La combustión a gas opera a temperaturas notablemente superiores a la gasolina, acelerando la nitración y degradación de los aceites comunes. Fórmulas como Lubexol Optimus Premium 20W-50 y Lubexol HD 50 Especial Gas cuentan con aditivos detergentes de alta estabilidad térmica y bajo contenido de cenizas que protegen las válvulas y previenen el desgaste de culata.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Venden por unidad suelta o cuál es la presentación de compra?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nos especializamos exclusivamente en venta mayorista por caja cerrada de 15 o 20 unidades de 1L. Este formato de fábrica elimina intermediarios y reduce significativamente el costo por litro para taxistas, particulares y talleres mecánicos frente a la compra minorista en grifos.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Cómo se coordinan los envíos en Lima Metropolitana y Callao?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Coordinamos despachos directos y seguros a tu taller, cochera o domicilio en todo Lima y Callao. Al presionar "Cotizar por WhatsApp", nuestro asesor te confirma disponibilidad de stock inmediato, costo preferencial de envío y ventana de entrega para tu pedido.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Qué medios de pago aceptan y si entregan Boleta o Factura?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sí, emitimos Boleta de venta y Factura electrónica con RUC para personas naturales con negocio o flotas comerciales que deseen deducir costos. Los pagos se coordinan de forma transparente por transferencia bancaria oficial, Yape/Plin o contraentrega según la zona acordada.',
      },
    },
  ],
};
---
<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aceite de Motor por Caja al Mejor Precio Mayorista en Lima — Aceite de Motor Lima</title>
    <meta
      name="description"
      content="Venta y cotización de lubricantes de motor por caja para particulares, taxistas y flotas en Lima y Callao. Fórmulas para Gasolina, GNV/GLP y Diésel."
    />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:title" content="Aceite de Motor por Caja en Lima y Callao — Distribuidor Mayorista" />
    <meta
      property="og:description"
      content="Ahorra comprando directo por caja. Cotización inmediata por WhatsApp con asesor verificado."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="google-site-verification" content="MD814Y5SCMxmDpiT1PDnhvpDlhCV-C_oPhKIqwGqi4U" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased" data-whatsapp={whatsappNumber}>
    <!-- Top Bar de Anuncio -->
    <div class="bg-slate-900 px-4 py-2 text-center text-xs font-medium text-slate-200">
      📍 Venta exclusiva por caja cerrada · Envíos y coordinación rápida en Lima Metropolitana y Callao
    </div>

    <!-- Navegación Principal -->
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2 sm:px-6">
        <a href="/" class="flex items-center gap-2">
          <span class="text-sm sm:text-base font-black tracking-tight text-slate-900 uppercase">
            Aceite de Motor <span class="text-amber-500">Lima</span>
          </span>
          <span class="hidden sm:inline-block rounded bg-amber-100 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-amber-900">
            Dist. Mayorista
          </span>
        </a>
        <nav class="hidden flex-1 items-center justify-center gap-8 text-sm font-semibold text-slate-600 md:flex">
          <a href="#catalogo" class="transition-colors hover:text-slate-900">Catálogo</a>
          <a href="/blog" class="transition-colors hover:text-slate-900">Blog</a>
          <a href="/podcast" class="transition-colors hover:text-slate-900">Podcast</a>
        </nav>
        <div class="flex items-center gap-3">
          <a
            href={defaultWaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg bg-emerald-600 px-4 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-500 sm:text-sm"
          >
            <span>Cotizar por WhatsApp</span>
          </a>
        </div>
      </div>
      <!-- Pestañas de Navegación Móvil -->
      <div class="flex items-center justify-center gap-8 border-t border-slate-100 py-1.5 text-xs font-semibold text-slate-600 md:hidden">
        <a href="#catalogo" class="hover:text-slate-900">Catálogo</a>
        <a href="/blog" class="hover:text-slate-900">Blog</a>
        <a href="/podcast" class="hover:text-slate-900">Podcast</a>
      </div>
    </header>

    <main>
      <!-- Hero Section -->
      <section class="relative overflow-hidden bg-gradient-to-b from-white via-slate-50 to-slate-100 px-4 py-16 sm:px-6 lg:py-24">
        <div class="mx-auto max-w-5xl text-center">
          <div class="inline-flex items-center gap-2 rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-900">
            <span>⭐ Precios Directos por Caja Cerrada</span>
          </div>
          <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
            Aceite de Motor por Caja al <span class="text-amber-600">Mejor Precio Mayorista</span> en Lima y Callao
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-base text-slate-600 sm:text-lg">
            Ahorra en cada mantenimiento comprando directo por caja de 15 o 20 unidades. Fórmulas homologadas <strong>Lubexol</strong> para <strong>Gasolina, GNV/GLP y Diésel de trabajo pesado</strong> con precinto de inviolabilidad y despacho rápido a tu taller o domicilio.
          </p>

          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:items-center">
            <a
              href="#catalogo"
              class="inline-flex items-center justify-center rounded-lg bg-slate-950 px-6 py-3.5 text-sm font-bold text-white shadow-lg transition hover:bg-slate-800"
            >
              Explorar Catálogo de Productos ↓
            </a>
            <a
              href={defaultWaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-6 py-3.5 text-sm font-bold text-slate-800 shadow-sm transition hover:bg-slate-50"
            >
              Cotizar por WhatsApp
            </a>
          </div>

          <!-- Sellos de Confianza -->
          <div class="mt-12 grid grid-cols-2 gap-4 border-t border-slate-200/80 pt-8 sm:grid-cols-4">
            <div class="text-center">
              <p class="text-xl font-black text-slate-900">100%</p>
              <p class="text-xs text-slate-500">Sellado de Fábrica</p>
            </div>
            <div class="text-center">
              <p class="text-xl font-black text-slate-900">GNV / GLP</p>
              <p class="text-xs text-slate-500">Alta Protección Térmica</p>
            </div>
            <div class="text-center">
              <p class="text-xl font-black text-slate-900">15 y 20u</p>
              <p class="text-xs text-slate-500">Cajas Cerradas</p>
            </div>
            <div class="text-center">
              <p class="text-xl font-black text-slate-900">Lima & Callao</p>
              <p class="text-xs text-slate-500">Entrega Rápida</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Propuesta de Valor / Beneficios -->
      <section id="beneficios" class="border-y border-slate-200 bg-white px-4 py-16 sm:px-6">
        <div class="mx-auto max-w-5xl">
          <div class="text-center">
            <h2 class="text-xs font-bold uppercase tracking-wider text-amber-600">¿Por qué comprar con nosotros?</h2>
            <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
              Diseñado para Taxistas, Talleres y Dueños de Vehículos
            </p>
          </div>

          <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-6 shadow-sm">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-500 text-lg font-bold text-white">
                📦
              </div>
              <h3 class="mt-4 text-base font-bold text-slate-900">Ahorro por Caja</h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-600">
                Olvídate de pagar sobreprecio por litro en grifos. Compra la caja cerrada y reduce hasta 30% tu costo anual de lubricación.
              </p>
            </div>

            <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-6 shadow-sm">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-600 text-lg font-bold text-white">
                🚕
              </div>
              <h3 class="mt-4 text-base font-bold text-slate-900">Especialistas en GNV/GLP</h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-600">
                Los motores a gas operan a mayor temperatura. Nuestras fórmulas resisten la nitración y previenen el desgaste de válvulas.
              </p>
            </div>

            <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-6 shadow-sm">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-600 text-lg font-bold text-white">
                ⚡
              </div>
              <h3 class="mt-4 text-base font-bold text-slate-900">Cotización Inmediata</h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-600">
                Sin pasarelas lentas ni formularios engorrosos. Elige tu pedido y habla directamente con un asesor por WhatsApp en 1 clic.
              </p>
            </div>

            <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-6 shadow-sm">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-slate-900 text-lg font-bold text-white">
                🚚
              </div>
              <h3 class="mt-4 text-base font-bold text-slate-900">Lima Metropolitana</h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-600">
                Coordinamos entregas directas a tu taller mecánico, cochera o punto convenido con seguridad y rapidez.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Catálogo de Productos Oficiales -->
      <section id="catalogo" class="px-4 py-16 sm:px-6">
        <div class="mx-auto max-w-5xl">
          <div class="flex flex-col items-start justify-between gap-4 border-b border-slate-200 pb-6 sm:flex-row sm:items-end">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-600">Catálogo Oficial</span>
              <h2 class="mt-1 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
                Línea de Lubricantes Lubexol
              </h2>
              <p class="mt-1 text-xs text-slate-500">
                Selecciona la presentación y cantidad de cajas para solicitar tu cotización al instante.
              </p>
            </div>
            <a
              href="/catalogo"
              class="inline-flex items-center gap-1 text-xs font-semibold text-slate-700 underline hover:text-slate-950"
            >
              Ver vista de catálogo extendida →
            </a>
          </div>

          {!whatsappNumber && (
            <div class="mt-6 rounded border border-amber-300 bg-amber-50 p-3 text-xs text-amber-800">
              Configura <code>PUBLIC_WHATSAPP_NUMBER</code> en <code>.env</code> para habilitar la cotización.
            </div>
          )}

          {hasProducts ? (
            <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="catalog-grid">
              {catalog.map((product) => <ProductCard product={product} />)}
            </div>
          ) : (
            <div class="mt-8 rounded-lg border border-dashed border-slate-300 bg-white p-12 text-center">
              <p class="text-base font-medium text-slate-700">Catálogo en preparación</p>
              <p class="mt-2 text-xs text-slate-500">
                Los productos se sincronizarán en la siguiente actualización.
              </p>
            </div>
          )}
        </div>
      </section>

      <!-- Tabla de Equivalencias y Comparativa de Ahorro Real -->
      <section id="equivalencias" class="border-t border-slate-200 bg-slate-50 px-4 py-16 sm:px-6">
        <div class="mx-auto max-w-5xl">
          <div class="text-center">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-600">Transparencia y Ahorro Directo</span>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
              ¿Por qué pagar sobreprecio por litro en grifos y lubricentros?
            </h2>
            <p class="mx-auto mt-2 max-w-2xl text-xs text-slate-600 sm:text-sm">
              Compara la especificación técnica internacional y calcula cuánto ahorras comprando la caja cerrada directa de fábrica.
            </p>
          </div>

          <div class="mt-8 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="border-b border-slate-200 bg-slate-900 text-white">
                <tr>
                  <th class="p-3 sm:p-4">Uso / Viscosidad</th>
                  <th class="p-3 sm:p-4">Marca Referencia (Grifo)</th>
                  <th class="p-3 sm:p-4">Precio aprox. / Litro</th>
                  <th class="p-3 sm:p-4">Fórmula Homologada Lubexol</th>
                  <th class="p-3 sm:p-4">Precio / Litro en Caja</th>
                  <th class="p-3 sm:p-4 font-black text-amber-400">Tu Ahorro por Caja</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-700">
                <tr class="hover:bg-slate-50/80">
                  <td class="p-3 font-bold text-slate-900 sm:p-4">GNV / GLP / Gasolina (20W-50)</td>
                  <td class="p-3 sm:p-4 text-slate-500">Mobil Super / Castrol GTX</td>
                  <td class="p-3 sm:p-4 text-rose-600 font-semibold">S/ 26.00 – S/ 29.00</td>
                  <td class="p-3 sm:p-4 font-semibold text-slate-900">Optimus Premium 20W-50 (API-SN)</td>
                  <td class="p-3 sm:p-4 font-bold text-emerald-700">S/ 16.50</td>
                  <td class="p-3 sm:p-4 font-black text-emerald-600 bg-emerald-50/50">Ahorras ~S/ 150 por caja</td>
                </tr>
                <tr class="hover:bg-slate-50/80">
                  <td class="p-3 font-bold text-slate-900 sm:p-4">Diésel Pesado / Flotas (15W-40)</td>
                  <td class="p-3 sm:p-4 text-slate-500">Rimula R4 / Delvac 1300</td>
                  <td class="p-3 sm:p-4 text-rose-600 font-semibold">S/ 28.00 – S/ 32.00</td>
                  <td class="p-3 sm:p-4 font-semibold text-slate-900">Ultra Oil 15W-40 (API CI-4 Plus)</td>
                  <td class="p-3 sm:p-4 font-bold text-emerald-700">S/ 17.50</td>
                  <td class="p-3 sm:p-4 font-black text-emerald-600 bg-emerald-50/50">Ahorras ~S/ 165 por caja</td>
                </tr>
                <tr class="hover:bg-slate-50/80">
                  <td class="p-3 font-bold text-slate-900 sm:p-4">Gas Monogrado Alto Calor (SAE 50)</td>
                  <td class="p-3 sm:p-4 text-slate-500">Lubricantes Grifo Monogrado</td>
                  <td class="p-3 sm:p-4 text-rose-600 font-semibold">S/ 22.00 – S/ 25.00</td>
                  <td class="p-3 sm:p-4 font-semibold text-slate-900">HD 50 Especial Gas (API-SL/CF)</td>
                  <td class="p-3 sm:p-4 font-bold text-emerald-700">S/ 14.50</td>
                  <td class="p-3 sm:p-4 font-black text-emerald-600 bg-emerald-50/50">Ahorras ~S/ 130 por caja</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Garantía Total de Confianza -->
      <section class="border-t border-slate-200 bg-amber-500/10 px-4 py-12 sm:px-6">
        <div class="mx-auto max-w-4xl rounded-2xl border border-amber-300 bg-gradient-to-r from-amber-50 via-white to-amber-50 p-6 shadow-md sm:p-8">
          <div class="flex flex-col items-center gap-6 text-center sm:flex-row sm:text-left">
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-amber-500 text-3xl shadow-lg shadow-amber-500/30 text-white">
              🛡️
            </div>
            <div class="flex-1">
              <span class="inline-block rounded bg-amber-200/80 px-2.5 py-0.5 text-[11px] font-black uppercase tracking-wider text-amber-900">
                Garantía de Satisfacción 100% Cero Riesgo
              </span>
              <h3 class="mt-2 text-xl font-extrabold text-slate-950 sm:text-2xl">
                Prueba la 1era botella en tu motor sin ningún compromiso
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-700 sm:text-sm">
                Recibe tu caja sellada. Abre la primera botella, haz el cambio o relleno en tu motor y verifica la presión, suavidad y estabilidad térmica. Si por cualquier motivo no quedas 100% satisfecho, <strong>te devolvemos el dinero de las botellas restantes de la caja</strong> sin preguntas ni trabas.
              </p>
            </div>
            <div class="shrink-0">
              <a
                href={defaultWaUrl}
                target="_blank"
                rel="noopener noreferrer"
