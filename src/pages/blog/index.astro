---
import '@/styles/global.css';
import { getCollection } from 'astro:content';
import ArticleCard from '@/components/ArticleCard.astro';

const posts = await getCollection('blog', ({ data }) => data.status === 'published');
const hasPosts = posts.length > 0;
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '';
const defaultWaUrl = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hola Aceite de Motor Lima, quisiera información y asesoría sobre lubricantes.')}`
  : '#';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Blog Aceite de Motor Lima — Guías Técnicas y Mantenimiento de Motor</title>
    <meta
      name="description"
      content="Artículos técnicos, guías de viscosidad y consejos de mantenimiento preventivo para motores a Gasolina, GNV/GLP y Diésel en Lima y Callao."
    />
    <link rel="canonical" href="https://aceitedemotorlima.com/blog/" />
    <meta property="og:title" content="Blog Aceite de Motor Lima — Consejos de Lubricación" />
    <meta
      property="og:description"
      content="Aprende a proteger tu motor y ahorrar dinero comprando aceite por caja cerrada."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://aceitedemotorlima.com/blog/" />
    <meta property="og:url" content="https://aceitedemotorlima.com/blog" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f172a" />
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased">
    <!-- Top Bar -->
    <div class="bg-slate-900 px-4 py-2 text-center text-xs font-medium text-slate-200">
      📍 Blog Oficial de aceitedemotorlima.com · Consejos técnicos de lubricación y ahorro por caja
    </div>

    <!-- Header -->
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
        <a href="/" class="flex items-center gap-2">
          <span class="text-xl font-black tracking-tight text-slate-900 sm:text-2xl">
            ACEITE DE MOTOR <span class="text-amber-500">LIMA</span>
          </span>
          <span class="rounded bg-slate-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-600">
            Blog
          </span>
        </a>
        <nav class="hidden items-center gap-6 text-sm font-semibold text-slate-600 md:flex">
          <a href="/" class="transition-colors hover:text-slate-900">Inicio</a>
          <a href="/catalogo" class="transition-colors hover:text-slate-900">Catálogo</a>
          <a href="/podcast" class="transition-colors hover:text-slate-900">Podcast</a>
        </nav>
        <div class="flex items-center gap-3">
          <a
            href={defaultWaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-500 sm:text-sm"
          >
            <span>💬 Asesor WhatsApp</span>
          </a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <!-- Breadcrumb -->
      <nav class="mb-6 flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:underline">Inicio</a>
        <span>›</span>
        <span class="font-semibold text-slate-900">Blog</span>
      </nav>

      <!-- Hero Blog -->
      <div class="mb-12 max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-900">
          📚 Artículos de Consulta y Capacitación
        </span>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">
          Blog Aceite de Motor Lima
        </h1>
        <p class="mt-3 text-sm text-slate-600 sm:text-base">
          Guías claras y directas basadas en especificaciones técnicas de fábrica (SAE y API) para cuidar el motor de tu taxi, auto particular o flota de carga, optimizar el consumo de combustible y evitar compras de aceites adulterados.
        </p>
      </div>

      <!-- Listado de Artículos -->
      {hasPosts ? (
        <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              publishedAt={post.data.publishedAt}
              tags={post.data.tags}
            />
          ))}
        </section>
      ) : (
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center shadow-sm">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-amber-50 text-2xl">
            ✍️
          </div>
          <h3 class="mt-4 text-base font-bold text-slate-900">Próximas publicaciones en redacción</h3>
          <p class="mx-auto mt-2 max-w-md text-xs leading-relaxed text-slate-500">
            Nuestros asesores técnicos están preparando guías sobre lubricantes especializados para GNV/GLP, diferencias entre Monogrado y Multigrado, y análisis de costo por caja.
          </p>
          <div class="mt-6 flex justify-center gap-3">
            <a
              href="/catalogo"
              class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-bold text-white transition hover:bg-slate-800"
            >
              Ver Catálogo por Caja
            </a>
            <a
              href={defaultWaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 transition hover:bg-slate-50"
            >
              Consultar con un Asesor
            </a>
          </div>
        </div>
      )}
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 bg-slate-50 px-4 py-12 text-slate-600 sm:px-6">
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
          <div>
            <span class="text-xl font-black text-slate-900">
              ACEITE DE MOTOR <span class="text-amber-500">LIMA</span>
            </span>
            <p class="mt-1 text-xs text-slate-500">
              Venta mayorista de lubricantes por caja y educación técnica automotriz en Lima y Callao.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-4 text-xs font-medium text-slate-600">
            <a href="/" class="hover:text-slate-950">Inicio</a>
            <a href="/catalogo" class="hover:text-slate-950">Catálogo de Productos</a>
            <a href="/podcast" class="hover:text-slate-950">Podcast</a>
            <a href={defaultWaUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-emerald-700 hover:text-emerald-900">
              WhatsApp Asesor
            </a>
          </div>
        </div>
        <div class="mt-8 border-t border-slate-200 pt-6 text-center text-[11px] text-slate-400">
          © 2026 aceitedemotorlima.com. Todos los derechos reservados. Lima, Perú.
        </div>
      </div>
    </footer>
  </body>
</html>
