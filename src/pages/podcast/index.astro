---
import '@/styles/global.css';
import { getCollection } from 'astro:content';
import PodcastCard from '@/components/PodcastCard.astro';

const episodes = await getCollection('podcast', ({ data }) => data.status === 'published');
const hasEpisodes = episodes.length > 0;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Podcast — Lubexol</title>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <main class="mx-auto max-w-5xl p-8">
      <header class="mb-6 flex items-center justify-between">
        <h1 class="text-2xl font-bold">Podcast</h1>
        <a href="/" class="text-sm text-slate-600 hover:underline">Inicio</a>
      </header>

      {hasEpisodes ? (
        <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {episodes.map((ep) => (
            <PodcastCard
              title={ep.data.title}
              description={ep.data.description}
              slug={ep.slug}
              publishedAt={ep.data.publishedAt}
              duration={ep.data.duration}
            />
          ))}
        </section>
      ) : (
        <div class="rounded-lg border border-dashed border-slate-300 bg-white p-12 text-center">
          <p class="text-lg font-medium text-slate-700">Podcast en preparación</p>
          <p class="mt-2 text-sm text-slate-500">
            Los episodios se publicarán tras revisión humana. No se muestran contenidos de ejemplo.
          </p>
        </div>
      )}
    </main>
  </body>
</html>
