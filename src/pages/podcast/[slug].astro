---
import '@/styles/global.css';
import { getCollection } from 'astro:content';
import { catalog } from '@/data/catalog';
import type { Product } from '@/lib/contracts/catalog';

export const prerender = true;

export async function getStaticPaths() {
  const episodes = await getCollection('podcast', ({ data }) => data.status === 'published');
  return episodes.map((ep) => ({ params: { slug: ep.slug }, props: { ep } }));
}

const { ep } = Astro.props;

const related = (ep.data.relatedProducts || [])
  .map((id) => catalog.find((p) => p.id === id && p.status !== 'archived'))
  .filter((p): p is Product => Boolean(p));

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '';
const canonicalUrl = `https://aceitedemotorlima.com/podcast/${ep.slug}`;

// Extraer ID de YouTube si existe
let youtubeEmbedUrl = '';
if (ep.data.youtubeUrl) {
  const match = ep.data.youtubeUrl.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
  if (match) {
    youtubeEmbedUrl = `https://www.youtube.com/embed/${match[1]}`;
  }
}

const schemaPodcast = {
  '@context': 'https://schema.org',
  '@type': 'PodcastEpisode',
  name: ep.data.title,
  description: ep.data.description,
  datePublished: ep.data.publishedAt.toISOString(),
  timeRequired: ep.data.duration,
  associatedMedia: {
    '@type': 'MediaObject',
    contentUrl: ep.data.audioUrl,
  },
  partOfSeries: {
    '@type': 'PodcastSeries',
    name: 'Podcast Aceite de Motor Lima',
    url: 'https://aceitedemotorlima.com/podcast',
  },
  url: canonicalUrl,
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ep.data.title} — Podcast Aceite de Motor Lima</title>
    <meta name="description" content={ep.data.description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={`${ep.data.title} — Podcast Aceite de Motor Lima`} />
    <meta property="og:description" content={ep.data.description} />
    <meta property="og:type" content="video.other" />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f172a" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaPodcast)} />
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased">
    <!-- Header -->
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur-md">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3 sm:px-6">
        <a href="/" class="flex items-center gap-2">
          <span class="text-xl font-black tracking-tight text-slate-900 sm:text-2xl">
            ACEITE DE MOTOR <span class="text-amber-500">LIMA</span>
          </span>
          <span class="rounded bg-slate-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-600">
            Podcast
          </span>
        </a>
        <nav class="hidden items-center gap-6 text-sm font-semibold text-slate-600 md:flex">
          <a href="/" class="transition-colors hover:text-slate-900">Inicio</a>
          <a href="/catalogo" class="transition-colors hover:text-slate-900">Catálogo</a>
          <a href="/blog" class="transition-colors hover:text-slate-900">Blog</a>
          <a href="/podcast" class="text-slate-900">Podcast</a>
        </nav>
        {whatsappNumber && (
          <a
            href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Hola, escuché el episodio "${ep.data.title}" en su podcast y quisiera cotizar lubricantes por caja.`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-500"
          >
            <span>💬 Cotizar</span>
          </a>
        )}
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
      <!-- Breadcrumb -->
      <nav class="mb-6 flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:underline">Inicio</a>
        <span>›</span>
        <a href="/podcast" class="hover:underline">Podcast</a>
        <span>›</span>
        <span class="truncate font-semibold text-slate-900">{ep.data.title}</span>
      </nav>

      <article>
        <!-- Cabecera del Episodio -->
        <header class="border-b border-slate-200 pb-8">
          <div class="mb-3 flex items-center gap-2">
            <span class="rounded border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-blue-900">
              🎙️ Episodio de Audio
            </span>
            {ep.data.duration && (
              <span class="rounded bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-600">
                ⏱️ {ep.data.duration}
              </span>
            )}
          </div>

          <h1 class="text-2xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">
            {ep.data.title}
          </h1>

          <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
            {ep.data.description}
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-4 text-xs text-slate-500">
            <span class="font-semibold text-slate-700">🎤 Conducción: {ep.data.host}</span>
            <span>·</span>
            <time datetime={ep.data.publishedAt.toISOString()}>
              📅 Publicado: {ep.data.publishedAt.toLocaleDateString('es-PE', { day: '2-digit', month: 'long', year: 'numeric' })}
            </time>
          </div>
        </header>

        <!-- Reproductor de Audio Principal -->
        <section class="mt-8 rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-900 to-slate-800 p-6 text-white shadow-md">
          <div class="flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-amber-500 text-slate-950 text-xl font-bold">
              ▶
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-amber-400 font-bold">Reproducir Episodio</p>
              <h3 class="text-sm font-bold text-white sm:text-base">{ep.data.title}</h3>
            </div>
          </div>

          <div class="mt-6">
            <audio controls preload="none" class="w-full rounded-lg" src={ep.data.audioUrl}>
              Tu navegador no soporta el reproductor de audio HTML5.
            </audio>
          </div>

          <p class="mt-3 text-[11px] text-slate-400">
            Audio bajo demanda: reproduce directamente desde tu celular o computadora sin descargar archivos pesados.
          </p>
        </section>

        <!-- Embebido de Video YouTube (Si existe) -->
        {youtubeEmbedUrl && (
          <section class="mt-8">
            <h3 class="mb-3 text-sm font-bold text-slate-900">Ver versión en video (YouTube):</h3>
            <div class="aspect-video w-full overflow-hidden rounded-xl border border-slate-200 bg-black shadow-sm">
              <iframe
                src={youtubeEmbedUrl}
                title={ep.data.title}
                class="h-full w-full border-0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </section>
        )}

        <!-- Transcripción Completa -->
        {ep.data.transcript && (
          <section class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
            <div class="flex items-center gap-2 border-b border-slate-100 pb-4">
              <span class="text-xl">📝</span>
              <div>
                <h2 class="text-base font-bold text-slate-900">Transcripción completa del episodio</h2>
                <p class="text-xs text-slate-500">Lectura indexable de las respuestas brindadas en el audio</p>
              </div>
            </div>
            <div class="prose prose-slate mt-6 max-w-none text-sm leading-relaxed text-slate-700 whitespace-pre-line">
              {ep.data.transcript}
            </div>
          </section>
        )}

        <!-- Banner de Reseñas en Google Maps -->
        <section class="my-10 rounded-2xl border-2 border-amber-200 bg-amber-50/70 p-6 text-center shadow-sm">
          <div class="flex justify-center text-amber-500 text-lg mb-2">★★★★★</div>
          <h3 class="text-base font-bold text-slate-900">¿Ya compraste tu caja de lubricante con nosotros?</h3>
          <p class="text-xs text-slate-600 max-w-md mx-auto mt-1 mb-4">
            Tu opinión ayuda a miles de taxistas y talleres de Lima a acceder a lubricantes originales al mejor precio mayorista.
          </p>
          <a
            href="https://g.page/r/CR7FTea8wDSDECE/review"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-xs font-bold text-white transition hover:bg-slate-800 shadow"
          >
            <span>⭐ Dejar una reseña en Google</span>
          </a>
        </section>

        <!-- Productos Tratados en el Episodio -->
        {related.length > 0 && (
          <aside class="mt-12 rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-6 shadow-sm">
            <div class="flex items-center gap-2">
              <span class="text-xl">📦</span>
              <h3 class="text-base font-bold text-slate-900">Lubricantes mencionados en este audio</h3>
            </div>
            <p class="mt-1 text-xs text-slate-600">
              Cotiza directamente por caja cerrada con nuestro asesor en Lima y Callao:
            </p>

            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {related.map((prod) => (
                <div class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-4">
                  <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-amber-700">
                      {prod?.gradeType ? `• ${prod.gradeType}` : '• LUBRICANTE'}
                    </span>
                    <h4 class="mt-1 text-sm font-bold text-slate-900">{prod?.name}</h4>
                    <p class="mt-1 text-xs text-slate-500 line-clamp-2">{prod?.description}</p>
                  </div>
                  <div class="mt-4">
                    <a
                      href={whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Hola, escuché el episodio "${ep.data.title}" y quisiera cotizar una caja de ${prod?.name}.`)}` : '/catalogo'}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-lead-cta
                      data-product-id={prod.id}
                      data-product-name={prod.name}
                      data-fuel={prod.fuelCompatibility.join(',')}
                      data-container-size={prod.variants[0]?.volume}
                      data-box-units={prod.variants[0]?.allowedBoxUnits[0]}
                      data-source="podcast_related_product"
                      data-content-slug={ep.slug}
                      class="inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-slate-900 px-3 py-2 text-xs font-bold text-white transition hover:bg-slate-800"
                    >
                      <span>Cotizar por WhatsApp</span>
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </aside>
        )}
      </article>

      <div class="mt-10 border-t border-slate-200 pt-6">
        <a href="/podcast" class="inline-flex items-center gap-2 text-xs font-bold text-slate-700 hover:text-amber-600">
          ← Volver a todos los episodios del podcast
        </a>
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 bg-slate-50 px-4 py-8 text-center text-xs text-slate-500">
      © 2026 aceitedemotorlima.com · Consultas técnicas y cotizaciones directas por WhatsApp.
    </footer>

    <script>
      import { initEditorialLeadCtas } from '@/lib/lead-client';
      initEditorialLeadCtas();
    </script>
  </body>
</html>
