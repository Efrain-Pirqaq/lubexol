---
import '../styles/global.css';
import { catalog } from '@/data/catalog';
import ProductCard from '@/components/ProductCard.astro';

const hasProducts = catalog.length > 0;
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '';
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Catálogo de Aceites por Caja — Aceite de Motor Lima</title>
    <meta name="description" content="Catálogo mayorista y cotización de lubricantes de motor por caja para particulares y taxistas en Lima y Callao." />
    <link rel="canonical" href="https://aceitedemotorlima.com/catalogo" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f172a" />
  </head>
  <body class="bg-slate-50 text-slate-900" data-whatsapp={whatsappNumber}>
    <main class="mx-auto max-w-5xl p-6 sm:p-8">
      <header class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-5">
        <div>
          <a href="/" class="text-xl sm:text-2xl font-black tracking-tight text-slate-900">
            ACEITE DE MOTOR <span class="text-amber-500">LIMA</span>
          </a>
          <span class="ml-2 rounded bg-amber-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-amber-900">
            Distribuidor Mayorista
          </span>
          <p class="mt-1 text-xs text-slate-500">
            Catálogo oficial por caja cerrada de 15 o 20 unidades · Despacho en Lima y Callao
          </p>
        </div>
        <a href="/" class="self-start sm:self-auto rounded-lg border border-slate-300 px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 transition">
          ← Volver al Inicio
        </a>
      </header>

      {!whatsappNumber && (
        <div class="mb-6 rounded border border-amber-300 bg-amber-50 p-3 text-sm text-amber-800">
          Configura <code>PUBLIC_WHATSAPP_NUMBER</code> en <code>.env</code> para habilitar la cotización.
        </div>
      )}

      {hasProducts ? (
        <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="catalog-grid">
          {catalog.map((product) => <ProductCard product={product} />)}
        </section>
      ) : (
        <div class="rounded-lg border border-dashed border-slate-300 bg-white p-12 text-center">
          <p class="text-lg font-medium text-slate-700">Catálogo en preparación</p>
          <p class="mt-2 text-sm text-slate-500">
            Los productos se publicarán cuando el Product Owner confirme el catálogo verificado.
          </p>
        </div>
      )}
    </main>

    <!-- Modal de preselección -->
    <div
      id="modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-title"
      tabindex="-1"
    >
      <div class="w-full max-w-md rounded-lg bg-white p-6 shadow-xl">
        <h2 id="modal-title" class="text-lg font-bold text-slate-900">Confirmar cotización</h2>
        <div id="modal-summary" class="mt-4 space-y-1 text-sm text-slate-700" aria-live="polite"></div>
        <input
          type="text"
          id="modal-hp"
          name="website_hp"
          style="position:absolute;left:-9999px;opacity:0;pointer-events:none;"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <p class="mt-4 rounded bg-amber-50 p-3 text-xs text-amber-800">
          Al confirmar con el siguiente clic, serás redirigido al chat de WhatsApp para comunicarte
          directamente con nuestro asesor de Lubexol y coordinar precio, disponibilidad y entrega.
        </p>
        <div class="mt-4 flex gap-2">
          <button id="modal-cancel" type="button" class="flex-1 rounded border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
            Cancelar
          </button>
          <button id="modal-confirm" type="button" class="flex-1 rounded bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">
            Confirmar y abrir WhatsApp
          </button>
        </div>
      </div>
    </div>

    <script>
      // @ts-nocheck
      const whatsappNumber = document.body.dataset.whatsapp || '';
      const state = new Map(); // productId -> { variantId, boxUnits, boxCount, allowed }

      function setState(card, partial) {
        const pid = card.dataset.productId;
        const prev = state.get(pid) || {};
        const next = { ...prev, ...partial };
        state.set(pid, next);
        return next;
      }

      function initCard(card) {
        const pid = card.dataset.productId;
        const firstVariantBtn = card.querySelector('[data-variant]');
        const variantId = firstVariantBtn?.dataset.variant;
        const allowed = JSON.parse(firstVariantBtn?.dataset.allowed || '[]');
        const boxUnits = allowed[0] ?? 1;
        setState(card, { variantId, boxUnits, boxCount: 1, allowed });
        // mark active
        setActive(card, '[data-variant]', variantId, 'data-variant');
        setActive(card, '[data-box]', String(boxUnits), 'data-box');
      }

      function setActive(card, selector, value, attr) {
        card.querySelectorAll(selector).forEach((btn) => {
          const isActive = btn.getAttribute(attr) === String(value);
          btn.classList.toggle('border-slate-900', isActive);
          btn.classList.toggle('bg-slate-900', isActive);
          btn.classList.toggle('text-white', isActive);
          btn.classList.toggle('border-slate-300', !isActive);
        });
      }

      function renderBoxes(card, allowed) {
        const container = card.querySelector('[data-role="boxes"]');
        if (!container) return;
        container.innerHTML = '';
        allowed.forEach((u, i) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `rounded border px-3 py-1 text-sm ${i === 0 ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 hover:border-slate-500'}`;
          btn.dataset.box = String(u);
          btn.textContent = `${u}u`;
          container.appendChild(btn);
        });
      }

      document.querySelectorAll('[data-product-id]').forEach((card) => {
        initCard(card);

        card.addEventListener('click', (e) => {
          const target = e.target;
          if (!(target instanceof HTMLElement)) return;

          const variantBtn = target.closest('[data-variant]');
          if (variantBtn && card.contains(variantBtn)) {
            const variantId = variantBtn.dataset.variant;
            const allowed = JSON.parse(variantBtn.dataset.allowed || '[]');
            const boxUnits = allowed[0] ?? 1;
            setState(card, { variantId, allowed, boxUnits });
            setActive(card, '[data-variant]', variantId, 'data-variant');
            renderBoxes(card, allowed);
            setActive(card, '[data-box]', String(boxUnits), 'data-box');
            return;
          }

          const boxBtn = target.closest('[data-box]');
          if (boxBtn && card.contains(boxBtn)) {
            const boxUnits = Number(boxBtn.dataset.box);
            setState(card, { boxUnits });
            setActive(card, '[data-box]', String(boxUnits), 'data-box');
            return;
          }

          if (target.closest('[data-dec]')) {
            const input = card.querySelector('[data-count]');
            const next = Math.max(1, Number(input.value) - 1);
            input.value = String(next);
            setState(card, { boxCount: next });
            return;
          }

          if (target.closest('[data-inc]')) {
            const input = card.querySelector('[data-count]');
            const next = Math.min(999, Number(input.value) + 1);
            input.value = String(next);
            setState(card, { boxCount: next });
            return;
          }

          if (target.closest('[data-count]')) {
            const input = target;
            const val = Math.max(1, Math.min(999, Number(input.value) || 1));
            input.value = String(val);
            setState(card, { boxCount: val });
            return;
          }

          if (target.closest('[data-quote]')) {
            if (!whatsappNumber) {
              alert('Configura PUBLIC_WHATSAPP_NUMBER en .env para habilitar la cotización.');
              return;
            }
            const quoteBtn = target.closest('[data-quote]');
            const originalText = quoteBtn.innerHTML;
            quoteBtn.disabled = true;
            quoteBtn.innerHTML = '<span>⚡ Abriendo WhatsApp...</span>';

            const pid = card.dataset.productId;
            const s = state.get(pid);
            const variantBtn = card.querySelector(`[data-variant="${s.variantId}"]`);
            const volume = variantBtn?.dataset.volume || '';

            const payload = {
              productId: pid,
              productName: card.dataset.productName,
              fuelCompatibility: card.dataset.fuel.split(',').filter(Boolean),
              containerSize: volume,
              boxUnits: s.boxUnits,
              boxCount: s.boxCount,
              totalUnits: s.boxUnits * s.boxCount,
              source: 'catalogo_direct',
              timestamp: new Date().toISOString(),
              renderTimestamp: Date.now(),
              website_hp: '',
            };

            // Registro asíncrono en segundo plano
            fetch('/api/lead', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
              keepalive: true,
            }).catch(() => console.warn('Registro asíncrono en proceso'));

            const gradeInfo = (card as HTMLElement).dataset.grade ? ` [${(card as HTMLElement).dataset.grade}]` : '';
            const message = `Hola Aceite de Motor Lima, quisiera cotizar lo siguiente con un asesor:\n- Producto: ${payload.productName}${gradeInfo}\n- Combustible: ${payload.fuelCompatibility.join(', ')}\n- Envase: ${payload.containerSize}\n- Empaque: Caja x ${payload.boxUnits} unidades\n- Cantidad: ${payload.boxCount} caja(s) (Total: ${payload.totalUnits} botellas)\n\n¿Podrían confirmarme disponibilidad y despacho rápido en Lima / Callao?`;
            const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;

            const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
            if (isMobile) {
              window.location.href = whatsappUrl;
            } else {
              window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
            }

            setTimeout(() => {
              quoteBtn.disabled = false;
              quoteBtn.innerHTML = originalText;
            }, 2500);
            return;
          }
        });
      });

      const modal = document.getElementById('modal');
      const cancelBtn = document.getElementById('modal-cancel');
      const confirmBtn = document.getElementById('modal-confirm');
      let lastTriggerElement: HTMLElement | null = null;

      function closeModal() {
        modal?.classList.add('hidden');
        modal?.classList.remove('flex');
        lastTriggerElement?.focus();
      }

      cancelBtn?.addEventListener('click', closeModal);

      // Cierre con ESC
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
          closeModal();
        }
      });

      // Cierre al clic en backdrop
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      // Focus trap básico en modal
      modal?.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab' || modal.classList.contains('hidden')) return;
        const focusable = modal.querySelectorAll<HTMLElement>(
          'button:not([disabled]), [href], input:not([tabindex="-1"]):not([type="hidden"]), select, textarea, [tabindex]:not([tabindex="-1"])'
        );
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });

      confirmBtn?.addEventListener('click', async () => {
        const pid = modal.dataset.productId;
        const card = document.querySelector(`[data-product-id="${pid}"]`);
        const s = state.get(pid);
        const variantBtn = card.querySelector(`[data-variant="${s.variantId}"]`);
        const volume = variantBtn?.dataset.volume || '';

        const payload = {
          productId: pid,
          productName: card.dataset.productName,
          fuelCompatibility: card.dataset.fuel.split(',').filter(Boolean),
          containerSize: volume,
          boxUnits: s.boxUnits,
          boxCount: s.boxCount,
          totalUnits: s.boxUnits * s.boxCount,
          source: 'product_card_modal',
          timestamp: new Date().toISOString(),
          renderTimestamp: Number(modal.dataset.modalOpenedAt) || Date.now(),
          website_hp: (document.getElementById('modal-hp') as HTMLInputElement)?.value || '',
        };

        // Fail-soft: no bloquear la venta
        fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          keepalive: true,
        }).catch(() => console.warn('Registro asíncrono en proceso'));

        const gradeInfo = (card as HTMLElement).dataset.grade ? ` [${(card as HTMLElement).dataset.grade}]` : '';
        const message = `Hola Lubexol, quisiera cotizar lo siguiente con su asesor:\n- Producto: ${payload.productName}${gradeInfo}\n- Combustible: ${payload.fuelCompatibility.join(', ')}\n- Envase: ${payload.containerSize}\n- Empaque: Caja x ${payload.boxUnits} unidades\n- Cantidad: ${payload.boxCount} caja(s) (Total: ${payload.totalUnits} unidades)\n\n¿Podrían confirmarme precio por caja, disponibilidad y condiciones de entrega?`;
        const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;

        const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
        if (isMobile) {
          window.location.href = whatsappUrl;
        } else {
          window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
        }
      });
    </script>
  </body>
</html>
