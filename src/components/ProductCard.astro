---
import type { Product } from '@/lib/contracts/catalog';
import { getBoxPrice15u, getPricePerLiter15u, REFERENCE_BOX_UNITS } from '@/data/prices';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const defaultVariant = product.variants[0];
const boxPrice = getBoxPrice15u(product.id);
const pricePerLiter = getPricePerLiter15u(product.id);
---

<article
  class="flex flex-col justify-between rounded-lg border border-slate-200 bg-white p-4 shadow-sm"
  data-product-id={product.id}
  data-product-name={product.name}
  data-fuel={product.fuelCompatibility.join(',')}
  data-grade={product.gradeType || ''}
>
  <div>
    {product.imageUrl && (
      <div class="relative mb-4 flex h-56 items-center justify-center overflow-hidden rounded-md bg-slate-50 p-2">
        {product.gradeType && (
          <span
            class={`absolute left-2 top-2 rounded px-2.5 py-1 text-[11px] font-black uppercase tracking-wider shadow-sm ${
              product.gradeType === 'Multigrado'
                ? 'bg-blue-600 text-white'
                : 'bg-amber-500 text-slate-950'
            }`}
          >
            {product.gradeType === 'Multigrado' ? '⚡ Multigrado' : '⚙️ Monogrado'}
          </span>
        )}
        <img
          src={product.imageUrl}
          alt={product.name}
          class="h-full w-auto object-contain transition-transform duration-300 hover:scale-105"
          loading="lazy"
        />
      </div>
    )}
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-base font-bold text-slate-900">{product.name}</h3>
      <span class="shrink-0 rounded bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-700">
        {product.fuelCompatibility.join(', ')}
      </span>
    </div>
    <p class="mt-2 text-xs leading-relaxed text-slate-600">{product.description}</p>
  </div>

  {boxPrice !== undefined && (
    <div class="mt-3 rounded-lg border border-emerald-200 bg-emerald-50 p-3">
      <p class="text-[11px] font-semibold uppercase tracking-wide text-emerald-900">
        Precio referencia · caja de {REFERENCE_BOX_UNITS}u
      </p>
      <p class="mt-0.5 text-xl font-black text-emerald-700">S/ {boxPrice.toFixed(2)}</p>
      <p class="text-[11px] text-emerald-800">
        S/ {pricePerLiter?.toFixed(2)} por litro · la caja de 20u se cotiza
      </p>
    </div>
  )}

  <div class="mt-3">
    <p class="text-xs font-medium text-slate-500">Envase</p>
    <div class="mt-1 flex flex-wrap gap-2" data-role="variants">
      {product.variants.map((v, i) => (
        <button
          type="button"
          class={`rounded border px-3 py-1 text-sm ${i === 0 ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 hover:border-slate-500'}`}
          data-variant={v.id}
          data-allowed={JSON.stringify(v.allowedBoxUnits)}
          data-volume={v.volume}
        >
          {v.volume}
        </button>
      ))}
    </div>
  </div>

  <div class="mt-3">
    <p class="text-xs font-medium text-slate-500">Cajas (según envase)</p>
    <div class="mt-1 flex flex-wrap gap-2" data-role="boxes">
      {defaultVariant.allowedBoxUnits.map((u, i) => (
        <button
          type="button"
          class={`rounded border px-3 py-1 text-sm ${i === 0 ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 hover:border-slate-500'}`}
          data-box={u}
        >
          {u}u
        </button>
      ))}
    </div>
  </div>

  <div class="mt-3 flex items-center gap-3">
    <span class="text-xs font-medium text-slate-500">Cantidad de cajas</span>
    <div class="flex items-center gap-2">
      <button type="button" class="rounded border border-slate-300 px-2 py-1 text-sm" data-dec>-</button>
      <input
        type="number"
        min="1"
        max="999"
        value="1"
        class="w-16 rounded border border-slate-300 px-2 py-1 text-center text-sm"
        data-count
      />
      <button type="button" class="rounded border border-slate-300 px-2 py-1 text-sm" data-inc>+</button>
    </div>
  </div>

  <button
    type="button"
    class="mt-4 w-full rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white shadow-md transition hover:bg-emerald-500 active:scale-[0.98] disabled:opacity-50"
    data-quote
  >
    Cotizar por WhatsApp
    <span class="block text-[11px] font-normal text-emerald-100">Atención inmediata con asesor · Clic directo</span>
  </button>
</article>
