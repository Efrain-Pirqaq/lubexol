---
interface Props {
  title: string;
  description: string;
  slug: string;
  publishedAt: Date;
  duration?: string;
}

const { title, description, slug, publishedAt, duration } = Astro.props;
---

<article class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
  <h3 class="text-lg font-semibold text-slate-900">
    <a href={`/podcast/${slug}`} class="hover:underline">{title}</a>
  </h3>
  <p class="mt-1 text-sm text-slate-600">{description}</p>
  <div class="mt-3 flex items-center justify-between text-xs text-slate-500">
    <time datetime={publishedAt.toISOString()}>{publishedAt.toLocaleDateString('es-PE')}</time>
    {duration && <span>{duration}</span>}
  </div>
</article>
