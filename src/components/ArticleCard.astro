---
interface Props {
  title: string;
  description: string;
  slug: string;
  publishedAt: Date;
  tags?: string[];
}

const { title, description, slug, publishedAt, tags = [] } = Astro.props;
---

<article class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-amber-400 hover:shadow-md">
  <div>
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <span class="rounded border border-amber-200 bg-amber-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-amber-900">
        Guía Técnica
      </span>
      {tags.map((t) => (
        <span class="rounded bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-600">
          #{t}
        </span>
      ))}
    </div>
    <h3 class="text-base font-bold text-slate-900 transition hover:text-amber-600">
      <a href={`/blog/${slug}`} class="focus:outline-none">{title}</a>
    </h3>
    <p class="mt-2 text-xs leading-relaxed text-slate-600 line-clamp-3">{description}</p>
  </div>
  <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3 text-[11px] text-slate-500">
    <time datetime={publishedAt.toISOString()}>
      {publishedAt.toLocaleDateString('es-PE', { day: '2-digit', month: 'short', year: 'numeric' })}
    </time>
    <a href={`/blog/${slug}`} class="font-bold text-slate-900 hover:text-amber-600">
      Leer guía →
    </a>
  </div>
</article>
